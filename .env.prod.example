# Copy to ".env" (in this same folder, next to docker-compose.prod.yml) and fill in.
# Use letters and numbers only for passwords (no @ : / # %).

# Local port on the VPS for MIRA (change if 8081 is already used by VIRA or anything else)
MIRA_PORT=8081

# Database password (choose a long random one)
POSTGRES_PASSWORD=ChangeThisDbPassword123

# Login tokens (long random text, e.g. from: openssl rand -hex 32)
JWT_SECRET=ChangeThisToALongRandomString
JWT_EXPIRES_IN=8h

# Storekeeper: assets go back to this person on check-in
STOREKEEPER_NAME=Muzakki
STOREKEEPER_SECTION=Project Engineer
STOREKEEPER_EMAIL=muzakki@example.com

# Email (SMTP) - from the solaraccess.id email admin, or Brevo/Resend
SMTP_HOST=mail.solaraccess.id
SMTP_PORT=587
SMTP_USER=mira@solaraccess.id
SMTP_PASS=ChangeThisMailPassword
MAIL_FROM=MIRA <mira@solaraccess.id>
CALIBRATION_REPORT_TO=muzakki@example.com
