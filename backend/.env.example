# Database (local dev uses docker-compose.dev.yml)
DATABASE_URL="postgresql://elina:elina@localhost:5432/elina_db?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Storekeeper: assets return to this person on check-in
STOREKEEPER_NAME="Muzakki"
STOREKEEPER_SECTION="Project Engineer"
STOREKEEPER_EMAIL=""

# Email (leave SMTP_HOST empty in development: emails are printed to the console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MIRA <mira@solaraccess.id>"
CALIBRATION_REPORT_TO=""

PORT=3000
UPLOAD_DIR="uploads"
